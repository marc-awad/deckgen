# MODEL of the Secret postgres-credentials, with fake values. Never put real values here.
#
# Never applied: it is not listed in kustomization.yaml ("kubectl apply -k deploy/" and Argo CD
# only read the listed files), and its extension .example keeps it out of "kubectl apply -f".
#
# Recommended: create the real Secret with the command of deploy/README.md (random password,
# nothing written to disk). Or, from a file:
#   1. Copy-Item deploy\postgres-credentials.yaml.example postgres-credentials.local.yaml
#      (at the root of the repository: "*.local.yaml" is ignored by git, and the file is
#      outside deploy/, so neither kustomize nor Argo CD can read it)
#   2. Replace the fake values below
#   3. kubectl create -f postgres-credentials.local.yaml
#      ("create", not "apply": apply would copy the whole file, password included, into the
#      kubectl.kubernetes.io/last-applied-configuration annotation of the Secret)
#   4. Remove-Item postgres-credentials.local.yaml
#
# The database keeps the credentials of its first start: once it has data, the Secret must
# always be created again with the SAME values (see README.md).
apiVersion: v1
kind: Secret
metadata:
  name: postgres-credentials
  namespace: deckgen
  labels:
    app.kubernetes.io/name: postgres
    app.kubernetes.io/component: database
    app.kubernetes.io/part-of: deckgen
type: Opaque
# stringData: plain values, encoded in base64 by Kubernetes when the Secret is stored
stringData:
  POSTGRES_USER: deckgen
  POSTGRES_PASSWORD: change-me
  POSTGRES_DB: deckgen
