# Template: at startup the image replaces ${API_UPSTREAM} and ${NGINX_LOCAL_RESOLVERS}
# (envsubst) and writes the result to /etc/nginx/conf.d/default.conf.
# Only defined environment variables are replaced: nginx variables like $uri stay as they are.

server {
    listen 8080;
    server_name _;
    root /usr/share/nginx/html;

    # Do not reveal the nginx version in headers and error pages
    server_tokens off;
    # Relative redirects: the published port may differ from 8080
    absolute_redirect off;

    # Basic security headers, also kept in locations that add their own headers
    add_header_inherit merge;
    add_header X-Content-Type-Options "nosniff" always;
    add_header X-Frame-Options "DENY" always;
    add_header Referrer-Policy "strict-origin-when-cross-origin" always;

    # Compress text responses (HTML is always compressed when gzip is on)
    gzip on;
    gzip_vary on;
    gzip_min_length 1024;
    gzip_types text/css application/javascript application/json image/svg+xml text/plain;

    # DNS servers of the container (127.0.0.11 on a Docker network), read at startup by the image.
    # With a resolver and a variable in proxy_pass, the api name is resolved at request time:
    # nginx starts even if the api does not exist yet.
    resolver ${NGINX_LOCAL_RESOLVERS} valid=10s ipv6=off;

    # Liveness of this container, answered by nginx itself (used by HEALTHCHECK)
    location = /health {
        access_log off;
        default_type text/plain;
        return 200 "ok\n";
    }

    # Same job as the Vite proxy in development: /api/decks is sent to the api as /decks
    location /api/ {
        set $api_upstream http://${API_UPSTREAM};
        rewrite ^/api/(.*)$ /$1 break;
        proxy_pass $api_upstream;

        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;

        # A generation can take several minutes
        proxy_read_timeout 300s;
        proxy_send_timeout 300s;
    }

    # Files built by Vite have a hash in their name: a new version gets a new name
    location /assets/ {
        add_header Cache-Control "public, max-age=31536000, immutable";
        try_files $uri =404;
    }

    # index.html points to the current assets: the browser must always check it again
    location = /index.html {
        add_header Cache-Control "no-cache";
    }

    # Version of the deployed build ({"version": "..."}), always checked again as well
    location = /version.json {
        add_header Cache-Control "no-cache";
    }

    # SPA fallback: /decks/3 is not a file, React Router displays the page from index.html
    location / {
        try_files $uri $uri/ /index.html;
    }
}
