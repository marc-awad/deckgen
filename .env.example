# Configuration read by docker compose. Copy this file to .env (Copy-Item .env.example .env).
# The .env file is ignored by git: keep your real password there, never in this file.

# PostgreSQL account, created at the first start of the database (required).
# Changing them later has no effect on an existing database volume.
POSTGRES_USER=deckgen
POSTGRES_PASSWORD=change-me
POSTGRES_DB=deckgen

# Ollama model downloaded at the first start (about 3 GB) and used by the generator
OLLAMA_MODEL=gemma3:4b

# Port of the application on this machine: http://localhost:8080
FRONTEND_PORT=8080

# NVIDIA GPU: uncomment so that "docker compose up" also loads docker-compose.gpu.yml.
# Separator between the files: ";" on Windows, ":" on Linux and macOS.
# COMPOSE_FILE=docker-compose.yml;docker-compose.gpu.yml
